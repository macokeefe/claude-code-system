# Kalshi API credentials — copy this file to `.env` and fill in your values.
# `.env` is gitignored; NEVER commit your real key.
#
# Get these from your Kalshi account: Settings -> API Keys -> Create.
# You'll receive a Key ID and download an RSA private-key file (once).

# Your Key ID (a uuid-looking string):
KALSHI_API_KEY_ID=your-key-id-here

# Point to the private-key file you downloaded:
KALSHI_PRIVATE_KEY_PATH=/absolute/path/to/kalshi_private_key.pem

# --- alternative to the path: paste the PEM contents inline instead ---
# (use one OR the other, not both)
# KALSHI_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
# ...
# -----END PRIVATE KEY-----"
